# Browser URL: http://localhost:5173
#
# Copy this file to .env and it starts as it is. The administrator account is created
# in the browser the first time you open the app, so no password is stored here.
#
# The sample_only_ values below are published in this repository, so everyone who copies
# them shares the same secrets. Replace them before anyone else can reach this machine:
#   Windows : start_docker.bat replaces every sample_only_ value with a random one
#   Other   : edit .env (openssl rand -hex 32 makes a good JWT_SECRET)
APP_PORT=5173
TZ=Asia/Tokyo
POSTGRES_VOLUME_NAME=nocode-app_postgres_data

POSTGRES_DB=nocode_db
POSTGRES_USER=postgres
# Only the containers use this. PostgreSQL keeps the value its data directory was
# created with, so changing it later needs a new volume (docker compose down -v).
POSTGRES_PASSWORD=sample_only_db_password_7c1f9a

# Sample value. Replace with at least 32 random bytes: openssl rand -hex 32
JWT_SECRET=sample_only_jwt_secret_replace_before_use_4b8e0d2f6a1c3e5709b2d4f6
JWT_EXPIRES_IN=8h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_MS=28800000
AUTH_EXPOSE_BEARER_TOKEN=false

# Leave INITIAL_ADMIN_PASSWORD empty to create the administrator in the browser on the
# first run (recommended). Set it only for unattended provisioning: when it holds a
# password of 12 characters or more, that administrator is created at startup instead.
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=

# Docker uses the same origin through Nginx. Set this only for direct cross-origin access.
CORS_ORIGINS=
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=10
SLOW_REQUEST_MS=1000
DB_SLOW_QUERY_MS=500
HTTP_LOG_MODE=slow
VITE_API_TIMEOUT_MS=20000

# Default LLM provider. Supported: lmstudio, ollama, openai, openrouter, groq, gemini, mistral, custom.
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=
LLM_API_KEY_HEADER=authorization
