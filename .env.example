# Browser URL: http://localhost:5173
#
# Three values below are left empty on purpose: POSTGRES_PASSWORD, JWT_SECRET and
# INITIAL_ADMIN_PASSWORD. Fill them in before starting, or run start_docker.bat on
# Windows to generate them. Docker refuses to start while the first two are empty.
APP_PORT=5173
TZ=Asia/Tokyo
POSTGRES_VOLUME_NAME=nocode-app_postgres_data

POSTGRES_DB=nocode_db
POSTGRES_USER=postgres
# Required. Any strong password; only the containers use it. PostgreSQL keeps the
# value its data directory was created with, so changing it later needs a new volume.
POSTGRES_PASSWORD=

# Required. Use at least 32 random bytes: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_MS=28800000
AUTH_EXPOSE_BEARER_TOKEN=false

# Used only when the database does not yet contain this administrator.
# Required until that administrator exists. 12 characters or more.
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=

# Docker uses the same origin through Nginx. Set this only for direct cross-origin access.
CORS_ORIGINS=
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=10
SLOW_REQUEST_MS=1000
DB_SLOW_QUERY_MS=500
HTTP_LOG_MODE=slow
VITE_API_TIMEOUT_MS=20000

# Default LLM provider. Supported: lmstudio, ollama, openai, openrouter, groq, gemini, mistral, custom.
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=
LLM_API_KEY_HEADER=authorization
