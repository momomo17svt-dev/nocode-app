# Browser URL: http://localhost:5173
APP_PORT=5173
POSTGRES_VOLUME_NAME=nocode-app_postgres_data

POSTGRES_DB=nocode_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_random_hex_value

# Use at least 32 random bytes. start_docker.bat generates this automatically.
JWT_SECRET=change_me_to_a_random_64_character_hex_value
JWT_EXPIRES_IN=8h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_MS=28800000
AUTH_EXPOSE_BEARER_TOKEN=false

# Used only when the database does not yet contain this administrator.
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=change_me_to_a_unique_password_of_12_or_more_characters

# Docker uses the same origin through Nginx. Set this only for direct cross-origin access.
CORS_ORIGINS=
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=10
SLOW_REQUEST_MS=1000
DB_SLOW_QUERY_MS=500
HTTP_LOG_MODE=slow
VITE_API_TIMEOUT_MS=20000

# Default LLM provider. Supported: lmstudio, ollama, openai, openrouter, groq, gemini, mistral, custom.
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=
LLM_API_KEY_HEADER=authorization
