# JWT_SECRET and INITIAL_ADMIN_PASSWORD are left empty on purpose. Fill them in before
# starting, or run setup.bat on Windows to generate them. The backend refuses to start
# while JWT_SECRET is empty.
#
# Matches the local PostgreSQL that setup.bat prepares (trust authentication).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nocode_db?schema=public
TZ=Asia/Tokyo
# Required. Use at least 32 random bytes: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_MS=28800000
AUTH_EXPOSE_BEARER_TOKEN=false

# Used only when the database does not yet contain this administrator.
# Required until that administrator exists. 12 characters or more.
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=10
SLOW_REQUEST_MS=1000
DB_SLOW_QUERY_MS=500
HTTP_LOG_MODE=slow
# Windowsでpg_dumpへPATHが通っていない場合だけ指定します。
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=
LLM_API_KEY_HEADER=authorization
