# Copy this file to backend/.env and it runs as it is. The two sample_only_ values below
# are published in this repository, so everyone who copies them shares the same secrets.
# Replace them before anyone else can reach this machine:
#   Windows : setup.bat replaces every sample_only_ value with a random one
#   Other   : edit backend/.env (openssl rand -hex 32 makes a good JWT_SECRET)
#
# Matches the local PostgreSQL that setup.bat prepares (trust authentication).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nocode_db?schema=public
TZ=Asia/Tokyo
# Sample value. Replace with at least 32 random bytes: openssl rand -hex 32
JWT_SECRET=sample_only_jwt_secret_replace_before_use_4b8e0d2f6a1c3e5709b2d4f6
JWT_EXPIRES_IN=8h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_MS=28800000
AUTH_EXPOSE_BEARER_TOKEN=false

# Used only when the database does not yet contain this administrator.
# Sample value. Change it, or change the password after the first sign-in.
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=sample_only_admin_password

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=10
SLOW_REQUEST_MS=1000
DB_SLOW_QUERY_MS=500
HTTP_LOG_MODE=slow
# Windowsでpg_dumpへPATHが通っていない場合だけ指定します。
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=
LLM_API_KEY_HEADER=authorization
